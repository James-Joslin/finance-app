POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=finances_db
POSTGRES_USER=finances_app
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_SSL_MODE=Disable

# Published Finova container release. Use sha-<commit> for a fixed release.
FINOVA_IMAGE_PREFIX=ghcr.io/james-joslin/finance-app
FINOVA_IMAGE_TAG=latest

APP_PORT=8080
AZURITE_ACCOUNT_NAME=finovabackups
AZURITE_ACCOUNT_KEY=CHANGE_ME_TO_A_BASE64_ENCODED_RANDOM_KEY
BACKUP_BLOB_CONTAINER=database-backups
BACKUP_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS=14

